# Copy this file to ".env" and fill in your real values.
# Get the two keys from your AWN account page: Account -> API Keys.
# (You need BOTH: the Application Key identifies this app, the API Key identifies your account.)

AWN_API_KEY=your_api_key_here
AWN_APP_KEY=your_application_key_here

# Your station's MAC address, shown in your AWN dashboard (looks like AA:BB:CC:DD:EE:FF)
AWN_MAC=AA:BB:CC:DD:EE:FF

# Your station's location, used only for the NWS forecast lookup.
LAT=39.7456
LON=-97.0892

# How often the collector logs a reading to the database (cron syntax). Default: every 5 minutes.
COLLECT_CRON=*/5 * * * *

# Port the dashboard is served on.
PORT=3000

# OPTIONAL: WAQI API token for Air Quality Index (AQI) display.
# Get a free token instantly at https://aqicn.org/data-platform/token/
# If not provided, the dashboard will hide the AQI tile gracefully.
# WAQI_API_TOKEN=your_waqi_token_here

# OPTIONAL: OpenUV API key for UV Index display.
# Get a free API key at https://www.openuv.io/ (50 requests/day free tier)
# If not provided, the dashboard will hide the UV tile gracefully.
# UV_API_KEY=your_openuv_api_key_here

# OPTIONAL: Web Push VAPID keys for browser push notifications
# Generate with: node generate-vapid-keys.js
# These keys enable automated weather alert notifications to users
# If not provided, notifications will still work but only as test notifications
# VAPID_PUBLIC_KEY=your_generated_public_key_here
# VAPID_PRIVATE_KEY=your_generated_private_key_here
# VAPID_SUBJECT=mailto:your-email@example.com
